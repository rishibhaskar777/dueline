{
  "name": "dueline",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/migrate.ts",
    "sandbox:check": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/sandbox-check.ts",
    "ai:check": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/ai-check.ts",
    "extract:check": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/extract-check.ts",
    "rates:check": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/rates-check.ts",
    "seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed-sandbox.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.107",
    "@base-ui/react": "^1.9.0",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "ai": "^7.0.156",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
