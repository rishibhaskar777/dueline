# Copy to .env.local. Every setting is listed with where it is needed:
#   live    = the full PayPal sandbox and Gemini setup (npm run dev, or a deployment)
#   offline = npm run dev:offline, which needs no setting at all and ignores accounts and keys
#   both    = read in either mode
# The examples after "Example:" are made up; use your own values.

# Live, required. PayPal Developer Dashboard, Apps and credentials, Sandbox tab. Example: AbCd1234sandboxClientId
PAYPAL_CLIENT_ID=
# Live, required. Same page as the client ID. Keep it secret. Example: EfGh5678sandboxClientSecret
PAYPAL_CLIENT_SECRET=
# Live, required. Always sandbox; the app refuses to start with anything else. Example: sandbox
PAYPAL_ENVIRONMENT=sandbox
# Live, required for payments to arrive. The ID of the webhook you create in the PayPal Developer
# Dashboard for https://your-domain/api/webhooks/paypal. Example: 1AB23456CD789012E
PAYPAL_WEBHOOK_ID=
# Live, required for AI drafts; without it Dueline asks you to fill invoices by hand and reminders use
# templates. Google AI Studio, Get API key. Example: AIzaSyExampleKeyNotReal
GEMINI_API_KEY=
# Live, required with the key. A Flash model marked free in Google AI Studio. Example: gemini-3.5-flash-lite
GEMINI_MODEL=
# Live, optional. A second Flash model used when the first is busy or out of quota.
# Example: gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=
# Live, optional. Neon dashboard, pooled connection string. Leave empty to keep data in memory (lost
# on restart). Offline always uses memory. Example: postgres://user:password@ep-example-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Live, optional. true (default) keeps the demo guard on: recipients must be PayPal sandbox buyers.
# Example: true
DEMO_MODE=true
# Both, optional. A date, YYYY-MM-DD, that the app treats as today. Leave empty on a deployment.
# Example: 2026-11-04
DEMO_TODAY=
# Live, required in production (without it the app screens are open to anyone). The password that
# opens the demo. Offline sets it to "offline". Example: a long phrase you choose
DEMO_PASSWORD=
# Live, required in production. Signs the demo cookie; at least 32 characters. Make one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Live, required for the daily job. Vercel sends it as "Authorization: Bearer <value>" to
# /api/cron/daily; without it that route answers 401. At least 16 characters. Make one with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
# Live, required to create the demo story. The US Personal sandbox account that pays demo invoices;
# it must end in @personal.example.com. Offline uses buyer@personal.example.com.
# Example: buyer@personal.example.com
SANDBOX_BUYER_EMAIL=
# Offline. true runs with no PayPal account, Gemini key or database. Use npm run dev:offline instead
# of setting it by hand. Refused on Vercel and in production outside CI. Example: true
DUELINE_OFFLINE=

# NODE_ENV, CI and VERCEL are set by Next.js, GitHub Actions and Vercel. Dueline reads them (for
# example to refuse offline mode on a deployment) but you never set them here.
