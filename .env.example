# PayPal Developer Dashboard, Apps & Credentials, Sandbox tab.
PAYPAL_CLIENT_ID=
# PayPal Developer Dashboard, Apps & Credentials, Sandbox tab.
PAYPAL_CLIENT_SECRET=
# Always sandbox; the app refuses to start with anything else.
PAYPAL_ENVIRONMENT=sandbox
# Created in the PayPal Developer Dashboard after the first deploy (webhook ID).
PAYPAL_WEBHOOK_ID=
# Google AI Studio, Get API key.
GEMINI_API_KEY=
# A Flash model marked free in Google AI Studio.
GEMINI_MODEL=
# A second Flash model marked free in Google AI Studio, used when the first is unavailable.
GEMINI_FALLBACK_MODEL=
# Neon dashboard, pooled connection string; leave empty to keep data in memory.
DATABASE_URL=
# Keep true while demoing; recipients must then be PayPal sandbox buyers.
DEMO_MODE=true
# Optional YYYY-MM-DD; makes the app treat this date as today.
DEMO_TODAY=
# Any password you choose. When set, the app screens and API routes ask for it. Required in production.
DEMO_PASSWORD=
# Signs the demo cookie; at least 32 characters. Required in production. Make one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Protects the daily preparation job; Vercel sends it as "Authorization: Bearer <value>" to the cron
# path. At least 16 characters. Without it /api/cron/daily answers 401. Make one with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
# The US Personal sandbox account that pays demo invoices (an address ending in @personal.example.com).
SANDBOX_BUYER_EMAIL=
# Set to true to run with no PayPal account, Gemini key or database. Use npm run dev:offline instead of
# setting it by hand. Refused on Vercel and in production outside CI.
DUELINE_OFFLINE=
