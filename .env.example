# PayPal Developer Dashboard, Apps & Credentials, Sandbox tab.
PAYPAL_CLIENT_ID=
# PayPal Developer Dashboard, Apps & Credentials, Sandbox tab.
PAYPAL_CLIENT_SECRET=
# Always sandbox; the app refuses to start with anything else.
PAYPAL_ENVIRONMENT=sandbox
# Created in the PayPal Developer Dashboard after the first deploy (webhook ID).
PAYPAL_WEBHOOK_ID=
# Google AI Studio, Get API key.
GEMINI_API_KEY=
# A Flash model marked free in Google AI Studio.
GEMINI_MODEL=
# A second Flash model marked free in Google AI Studio, used when the first is unavailable.
GEMINI_FALLBACK_MODEL=
# Neon dashboard, pooled connection string; leave empty to keep data in memory.
DATABASE_URL=
# Keep true while demoing; recipients must then be PayPal sandbox buyers.
DEMO_MODE=true
# Optional YYYY-MM-DD; makes the app treat this date as today.
DEMO_TODAY=
# Any password you choose; protects the demo reset.
DEMO_PASSWORD=
